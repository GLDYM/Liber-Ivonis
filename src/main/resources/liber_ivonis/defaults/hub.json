{
  "schemaVersion": 1,
  "theme": {
    "background": "#FF0D0F15",
    "surface": "#FF171A23",
    "surfaceAlt": "#FF2E3547",
    "accent": "#FFF2F5F9",
    "muted": "#FFAEB8C6",
    "outline": "#FF7FD9F5",
    "disabledOutline": "#FF2B3244"
  },
  "layout": {
